[Unit]
Description=Rollei Brightness Monitor
After=bluetooth.service multi-user.target
Wants=bluetooth.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStartPre=/bin/sleep 30
ExecStart=/usr/bin/python3 /home/pi/rollei_monitor.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
